# ─────────────────────────────────────────────────────────────────────────────
# IT Asset Lifecycle Management (Phase 1) — environment variables.
# Copy to .env and fill in. Never commit .env or real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 14+ connection string (required).
DATABASE_URL="postgresql://itam:change-me@localhost:5432/itam?schema=public"

# Test database. Tests DROP and recreate it, so its name must end in "_test".
# Defaults to DATABASE_URL's database name with "_test" appended.
TEST_DATABASE_URL="postgresql://itam:change-me@localhost:5432/itam_test?schema=public"

# Public base URL, used in email links. An https:// URL also marks the session cookie Secure.
APP_URL="http://localhost:3000"

# Base64 of exactly 32 random bytes. Encrypts integration secrets (pull tokens, LDAP bind passwords) at rest.
# Generate: openssl rand -base64 32
# Changing it makes stored integration secrets unreadable; re-enter them after a change.
ENCRYPTION_KEY=""

# Where uploaded documents and import files are stored. Mount a persistent, backed-up volume here in production.
STORAGE_DIR="./storage"

# Outbound email. Example: smtp://user:pass@smtp.example.com:587  (smtps:// for implicit TLS)
# Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465 (needs a Google App Password)
# Empty: nothing is sent; queued mail is marked FAILED ("Not sent") in Admin > Email outbox.
# Check with: npm run mail:test -- you@example.com
SMTP_URL=""
MAIL_FROM="IT Assets <no-reply@example.com>"

# true behind a TLS-terminating proxy: adds HSTS and marks the session cookie Secure.
FORCE_HTTPS="false"

# Number of reverse proxies you run in front of the app (usually 1). Only then is X-Forwarded-For
# trusted for sign-in rate limiting and audit IPs; with 0 it is ignored because clients can forge it.
TRUST_PROXY_HOPS="0"

# Virus scanning of uploads: none | clamav | http
VIRUS_SCAN_MODE="none"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
# http mode: the bytes are POSTed here; the scanner answers {"clean": true|false}.
VIRUS_SCAN_URL=""
# true: reject an upload when the scanner errors (otherwise it is stored and flagged "scan error").
VIRUS_SCAN_FAIL_CLOSED="false"

# bcrypt work factor for password hashes (default 12; tests use 4).
BCRYPT_COST="12"

# Worker poll interval in milliseconds (default 5000).
WORKER_TICK_MS="5000"

# Set to "query" to log SQL (development only).
PRISMA_LOG=""

# ── Demo data: DEVELOPMENT / UAT ONLY ────────────────────────────────────────
# `npm run db:seed` and `npm run db:generate-volume` refuse to run when NODE_ENV=production
# unless ALLOW_DEMO_SEED=true. Never set it on a live system.
ALLOW_DEMO_SEED="false"
# Password given to every demo account the seed creates. Leave empty to use the documented
# development default; set your own for any shared environment.
SEED_DEMO_PASSWORD=""
